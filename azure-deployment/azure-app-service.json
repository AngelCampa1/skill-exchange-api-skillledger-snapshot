{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "skillledger-api",
      "metadata": {
        "description": "Name of the Azure App Service"
      }
    },
    "appServicePlanName": {
      "type": "string",
      "defaultValue": "skillledger-plan",
      "metadata": {
        "description": "Name of the App Service Plan"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "P2v3",
      "allowedValues": [
        "P2v3",
        "P3v3",
        "S1",
        "S2",
        "S3"
      ],
      "metadata": {
        "description": "The SKU of App Service Plan"
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "skillledger-kv",
      "metadata": {
        "description": "Name of the Azure Key Vault"
      }
    },
    "sqlServerName": {
      "type": "string",
      "defaultValue": "skillledger-sql",
      "metadata": {
        "description": "Name of the Azure SQL Server"
      }
    },
    "sqlDatabaseName": {
      "type": "string",
      "defaultValue": "skillledger-db",
      "metadata": {
        "description": "Name of the Azure SQL Database"
      }
    },
    "appInsightsName": {
      "type": "string",
      "defaultValue": "skillledger-ai",
      "metadata": {
        "description": "Name of Application Insights"
      }
    }
  },
  "variables": {
    "appServicePlanId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
    "keyVaultId": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
    "appInsightsId": "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2021-03-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]"
      },
      "properties": {
        "perSiteScaling": false,
        "reserved": true,
        "targetWorkerCount": 1,
        "targetWorkerSizeId": 0
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2021-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
        "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"
      ],
      "kind": "app,linux,container",
      "properties": {
        "serverFarmId": "[variables('appServicePlanId')]",
        "siteConfig": {
          "appSettings": [
            {
              "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE",
              "value": "false"
            },
            {
              "name": "DOCKER_REGISTRY_SERVER_URL",
              "value": "https://index.docker.io/v1/"
            },
            {
              "name": "DOCKER_ENABLE_CI",
              "value": "true"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2015-05-01').InstrumentationKey]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2015-05-01').ConnectionString]"
            },
            {
              "name": "AZURE_KEY_VAULT_ENDPOINT",
              "value": "[reference(variables('keyVaultId')).vaultUri]"
            }
          ],
          "linuxFxVersion": "DOCKER|skillledger/api:latest",
          "alwaysOn": true,
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "remoteDebuggingEnabled": false,
          "webSocketsEnabled": true,
          "httpLoggingEnabled": true,
          "detailedErrorLoggingEnabled": true,
          "requestTracingEnabled": true,
          "healthCheckPath": "/health",
          "autoHealEnabled": true,
          "autoHealRules": {
            "triggers": {
              "requests": {
                "count": 10,
                "timeInterval": "00:01:00"
              },
              "statusCodes": [
                {
                  "status": 500,
                  "subStatus": -1,
                  "win32Status": -1,
                  "count": 5,
                  "timeInterval": "00:05:00"
                }
              ]
            },
            "actions": {
              "actionType": "CustomAction",
              "customAction": {
                "exe": "powershell.exe",
                "parameters": "-command \"Restart-WebApp -Name '[parameters('appName')]'\""
              }
            }
          }
        },
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false
      },
      "identity": {
        "type": "SystemAssigned"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2021-06-01-preview",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "accessPolicies": [],
        "enabledForTemplateDeployment": true,
        "enabledForDeployment": true,
        "enabledForDiskEncryption": true,
        "softDeleteRetentionInDays": 90,
        "networkAcls": {
          "defaultAction": "Allow",
          "bypass": "AzureServices"
        },
        "publicNetworkAccess": "enabled"
      }
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2021-02-01-preview",
      "name": "[parameters('sqlServerName')]",
      "location": "[parameters('location')]",
      "properties": {
        "administratorLogin": "sqladmin",
        "administratorLoginPassword": "[concat('P@ssword!', uniqueString(resourceGroup().id))]",
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled",
        "restrictOutboundNetworkAccess": "Disabled"
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2021-02-01-preview",
      "name": "[concat(parameters('sqlServerName'), '/', parameters('sqlDatabaseName'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('sqlServerName'))]"
      ],
      "sku": {
        "name": "S3",
        "tier": "Standard"
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 268435456000,
        "catalogCollation": "SQL_Latin1_General_CP1_CI_AS",
        "zoneRedundant": false,
        "autoPauseDelay": -1,
        "storageAccountType": "GRS",
        "backupStorageRedundancy": "Geo"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "SamplingPercentage": 10,
        "RetentionInDays": 90,
        "DisableIpMasking": false,
        "ImmediatePurgeDataOn30Days": false,
        "IngestionMode": "ApplicationInsights",
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    }
  ],
  "outputs": {
    "appServiceUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('appName'), '.azurewebsites.net')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(variables('keyVaultId')).vaultUri]"
    },
    "sqlConnectionString": {
      "type": "string",
      "value": "[concat('Server=tcp:', parameters('sqlServerName'), '.database.windows.net,1433;Initial Catalog=', parameters('sqlDatabaseName'), ';Persist Security Info=False;User ID=sqladmin;Password=', concat('P@ssword!', uniqueString(resourceGroup().id)), ';MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;')]"
    },
    "appInsightsInstrumentationKey": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2015-05-01').InstrumentationKey]"
    }
  }
}
