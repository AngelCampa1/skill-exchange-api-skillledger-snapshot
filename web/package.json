{
  "name": "skillledger-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:fresh": "node scripts/kill-ports.js && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "build:cf": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "preview": "yarn build:cf && wrangler dev",
    "deploy": "npm run build:cf && wrangler deploy --keep-vars",
    "validate-links": "npx tsx scripts/validate-links.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@microsoft/signalr": "^9.0.6",
    "@opennextjs/cloudflare": "^1.18.1",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.3",
    "emoji-picker-react": "^4.13.3",
    "focus-trap-react": "^11.0.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.542.0",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.48.2",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "web-vitals": "^5.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^29.5.8",
    "@types/jest-axe": "^3.5.9",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.6",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wrangler": "^4.90.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
