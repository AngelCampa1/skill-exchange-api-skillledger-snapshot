{
  "name": "skillledger-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "expose_global_message_channel"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "skillledger.app",
      "zone_name": "skillledger.app",
      "custom_domain": true
    },
    {
      "pattern": "www.skillledger.app",
      "zone_name": "skillledger.app",
      "custom_domain": true
    }
  ]
}
