# SkillLedger Frontend — Environment Variables
# Copy this file to .env.local for local development and fill in the values.

# ─── API ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8030
NEXT_PUBLIC_API_BASE_URL=http://localhost:8030/api

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SkillLedger
NEXT_PUBLIC_APP_ENV=development

# ─── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# ─── SignalR ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SIGNALR_HUB_URL=http://localhost:8030/hubs/messaging

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Error Tracking ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ─── Search Console ───────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ─── Ventora CRM Feedback Widget ──────────────────────────────────────────────
# Public key issued by the Ventora CRM for this product's feedback-button widget.
# Obtain from the CRM admin panel (Settings → Products → skillledger → Widget Keys).
# Leave blank to disable the widget (safe for CI and environments without CRM access).
# The CRM enforces an origin allowlist: the widget activates only on
# https://app.skillledger.app; requests from other origins no-op silently.
NEXT_PUBLIC_CRM_WIDGET_KEY=

# Override the CRM loader URL (optional — defaults to https://crm.example.com/w/v1.js).
# Only set this if you are running a local CRM instance for integration testing.
NEXT_PUBLIC_CRM_LOADER_URL=
