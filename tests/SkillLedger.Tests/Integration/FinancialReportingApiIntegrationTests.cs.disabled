    #region Export Service Integration Tests

    [Fact]
    public async Task FinancialExportService_ExportToCsv_ReturnsValidContent()
    {
        // Arrange
        var exportService = ServiceScope.ServiceProvider.GetRequiredService<IFinancialExportService>();
        var user = await CreateTestUserAsync("csvtest@example.com", "TestPassword123!");
        
        await CreateTestCreditTransactionsAsync(user.Id);
        var transactions = await GetTestTransactionSummaries(user.Id);

        // Act
        var csvContent = await exportService.ExportToCsvAsync(transactions);

        // Assert
        Assert.NotNull(csvContent);
        Assert.Contains("Date,Type,Amount,Description", csvContent);
        Assert.True(csvContent.Length > 100); // Should have substantial content
    }

    [Fact]
    public async Task FinancialExportService_ExportToJson_ReturnsValidContent()
    {
        // Arrange
        var exportService = ServiceScope.ServiceProvider.GetRequiredService<IFinancialExportService>();
        var testData = new { TestValue = "Test", Number = 123 };

        // Act
        var jsonContent = await exportService.ExportToJsonAsync(testData);

        // Assert
        Assert.NotNull(jsonContent);
        Assert.Contains("testValue", jsonContent); // camelCase
        Assert.Contains("123", jsonContent);
    }

    [Fact]
    public async Task FinancialExportService_ExportToXml_ReturnsValidContent()
    {
        // Arrange
        var exportService = ServiceScope.ServiceProvider.GetRequiredService<IFinancialExportService>();
        var testData = new { TestValue = "Test", Number = 123 };

        // Act
        var xmlContent = await exportService.ExportToXmlAsync(testData);

        // Assert
        Assert.NotNull(xmlContent);
        Assert.Contains("<?xml version=\"1.0\"", xmlContent);
        Assert.Contains("<FinancialData>", xmlContent);
        Assert.Contains("Test", xmlContent);
    }

    #endregion

    #region Budget and Goal Tests

    [Fact]
    public async Task FinancialReportingService_SetupBudgetTracking_Success()
    {
        // Arrange
        var user = await CreateTestUserAsync("budget@example.com", "TestPassword123!");
        var financialReportingService = ServiceScope.ServiceProvider.GetRequiredService<IFinancialReportingService>();

        var request = new BudgetTrackingRequest
        {
            UserId = user.Id,
            MonthlySpendingLimit = 10000,
            MonthlyEarningGoal = 15000,
            ProjectCompletionGoal = 5
        };

        // Act
        var result = await financialReportingService.SetupBudgetTrackingAsync(request);

        // Assert
        Assert.NotNull(result);
        Assert.True(result.Success);
    }

    #endregion

    #region Helper Methods

    private async Task CreateTestCreditTransactionsAsync(Guid userId)
    {
        using var scope = Factory.Services.CreateScope();
        var creditWalletService = scope.ServiceProvider.GetRequiredService<ICreditWalletService>();

        // Create some test transactions
        for (int i = 0; i < 5; i++)
        {
            await creditWalletService.AddCreditsAsync(userId, 1000 + (i * 100), 
                CreditTransactionType.ProjectPayment, $"Test transaction {i + 1}", Guid.NewGuid());
        }

        for (int i = 0; i < 3; i++)
        {
            await creditWalletService.DeductCreditsAsync(userId, 200 + (i * 50), 
                CreditTransactionType.PlatformFee, $"Test spending {i + 1}", Guid.NewGuid());
        }
    }

    private async Task CreateTestCreditWalletAsync(Guid userId, int initialBalance)
    {
        using var scope = Factory.Services.CreateScope();
        var creditWalletService = scope.ServiceProvider.GetRequiredService<ICreditWalletService>();

        await creditWalletService.CreateWalletAsync(userId);
        if (initialBalance > 0)
        {
            await creditWalletService.AddCreditsAsync(userId, initialBalance, 
                CreditTransactionType.StartingCredit, "Initial balance", Guid.NewGuid());
        }
    }

    private async Task<List<TransactionSummary>> GetTestTransactionSummaries(Guid userId)
    {
        // Create some test transaction summaries for export testing
        var transactions = new List<TransactionSummary>();
        
        for (int i = 0; i < 5; i++)
        {
            transactions.Add(new TransactionSummary
            {
                TransactionId = Guid.NewGuid(),
                Type = CreditTransactionType.ProjectPayment,
                Amount = 1000 + (i * 100),
                Description = $"Test transaction {i + 1}",
                CreatedAt = DateTime.UtcNow.AddDays(-i),
                Status = "Completed",
                IsIncoming = true,
                ProjectId = Guid.NewGuid(),
                ProjectTitle = $"Test Project {i + 1}"
            });
        }

        return transactions;
    }

    #endregion
}