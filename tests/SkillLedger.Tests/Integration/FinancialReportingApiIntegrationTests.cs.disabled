[Collection("IntegrationTestCollection")]
public class FinancialReportingApiIntegrationTests : IntegrationTestBase
{
    private readonly JsonSerializerOptions _jsonOptions;

    public FinancialReportingApiIntegrationTests(SharedTestWebApplicationFactory factory) 
        : base(factory)
    {
        _jsonOptions = new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        };
    }

    #region Service Integration Tests (Backend Logic)

    [Fact]
    public async Task FinancialReportingService_GenerateCreditSummaryReport_ReturnsValidReport()
    {
        // Arrange
        var user = await CreateTestUserAsync("test@example.com", "TestPassword123!");
        var financialReportingService = ServiceScope.ServiceProvider.GetRequiredService<IFinancialReportingService>();
        
        // Create test transactions
        await CreateTestCreditTransactionsAsync(user.Id);

        var request = new CreditReportRequest
        {
            UserId = user.Id,
            PeriodType = ReportPeriodType.Monthly,
            StartDate = DateTime.UtcNow.AddMonths(-1),
            EndDate = DateTime.UtcNow,
            IncludeTransactionDetails = true,
            IncludeProjectBreakdown = true
        };

        // Act
        var report = await financialReportingService.GenerateCreditSummaryReportAsync(request);

        // Assert
        Assert.NotNull(report);
        Assert.Equal(user.Id, report.UserId);
        Assert.NotNull(report.Summary);
        Assert.NotNull(report.Period);
        Assert.True(report.Summary.TransactionCount > 0);
        Assert.True(report.GeneratedAt > DateTime.MinValue);
    }

    [Fact]
    public async Task FinancialReportingService_GetUserDashboardData_ReturnsValidDashboard()
    {
        // Arrange
        var user = await CreateTestUserAsync("dashboard@example.com", "TestPassword123!");
        var financialReportingService = ServiceScope.ServiceProvider.GetRequiredService<IFinancialReportingService>();

        // Create test data
        await CreateTestCreditWalletAsync(user.Id, 5000);
        await CreateTestCreditTransactionsAsync(user.Id);

        // Act
        var dashboard = await financialReportingService.GetUserDashboardDataAsync(user.Id);

        // Assert
        Assert.NotNull(dashboard);
        Assert.Equal(user.Id, dashboard.UserId);
        Assert.NotNull(dashboard.Wallet);
        Assert.NotNull(dashboard.MonthlyStats);
        Assert.NotNull(dashboard.Goals);
        Assert.True(dashboard.Wallet.CurrentBalance > 0);
    }

    [Fact]
    public async Task FinancialReportingService_GetRealTimeAnalytics_ReturnsValidAnalytics()
    {
        // Arrange
        var user = await CreateTestUserAsync("analytics@example.com", "TestPassword123!");
        var financialReportingService = ServiceScope.ServiceProvider.GetRequiredService<IFinancialReportingService>();

        await CreateTestCreditTransactionsAsync(user.Id);

        var request = new AnalyticsRequest
        {
            UserId = user.Id,
            PeriodType = ReportPeriodType.Monthly,
            StartDate = DateTime.UtcNow.AddMonths(-1),
            EndDate = DateTime.UtcNow
        };

        // Act
        var analytics = await financialReportingService.GetRealTimeAnalyticsAsync(request);

        // Assert
        Assert.NotNull(analytics);
        Assert.Equal(user.Id, analytics.UserId);
        Assert.NotNull(analytics.CurrentBalance);
        Assert.NotNull(analytics.Spending);
        Assert.NotNull(analytics.Earnings);
    }

    [Fact]
    public async Task FinancialReportingService_ExportFinancialData_CSV_Success()
    {
        // Arrange
        var user = await CreateTestUserAsync("export@example.com", "TestPassword123!");
        var financialReportingService = ServiceScope.ServiceProvider.GetRequiredService<IFinancialReportingService>();

        await CreateTestCreditTransactionsAsync(user.Id);

        var request = new FinancialExportRequest
        {
            UserId = user.Id,
            Format = ExportFormat.CSV,
            StartDate = DateTime.UtcNow.AddMonths(-1),
            EndDate = DateTime.UtcNow,
            IncludePersonalInfo = false
        };

        // Act
        var exportResult = await financialReportingService.ExportFinancialDataAsync(request);

        // Assert
        Assert.NotNull(exportResult);
        Assert.True(exportResult.Success);
        Assert.Equal("text/csv", exportResult.ContentType);
        Assert.NotNull(exportResult.Content);
        Assert.Contains(".csv", exportResult.FileName);
    }

