        };

        // Act
        var pdfBytes = await _reportingService.ExportCreditSummaryAsPdfAsync(request);

        // Assert
        pdfBytes.Should().NotBeNullOrEmpty();
    }

    [Fact]
    public async Task ExportFinancialDataAsJsonAsync_ValidParameters_ShouldReturnJson()
    {
        // Arrange
        _exportService.SetupSuccess();

        // Act
        var json = await _reportingService.ExportFinancialDataAsJsonAsync(
            _testUserId,
            _testStartDate,
            _testEndDate);

        // Assert
        json.Should().NotBeNullOrEmpty();
        json.Should().Contain("{");  // Valid JSON structure
        json.Should().Contain("}");
    }

    [Fact]
    public async Task GetCategorizedTransactionBreakdownAsync_ValidParameters_ShouldReturnBreakdown()
    {
        // Act
        var breakdown = await _reportingService.GetCategorizedTransactionBreakdownAsync(
            _testUserId,
            _testStartDate,
            _testEndDate);

        // Assert
        breakdown.Should().NotBeNull();
        breakdown.Should().NotBeEmpty();
        breakdown.Should().Contain(b => b.Category == "ProjectEarnings");
        breakdown.Should().Contain(b => b.Category == "Purchase");
    }

    [Fact]
    public async Task GetProjectEarningsBreakdownAsync_ValidParameters_ShouldReturnBreakdown()
    {
        // Arrange - Create project for testing
        var project = new Project
        {
