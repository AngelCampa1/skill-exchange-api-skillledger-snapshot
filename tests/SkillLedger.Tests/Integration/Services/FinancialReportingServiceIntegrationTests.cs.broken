    [Fact]
    public async Task SetupBudgetTrackingAsync_ValidRequest_ShouldReturnSuccess()
    {
        // Arrange
        var request = new BudgetSetupRequest
        {
            UserId = _testUserId,
            MonthlyBudget = 2000,
            Category = "ProjectEarnings",
            AlertThreshold = 80  // Alert at 80% of budget
        };

        // Act
        var result = await _reportingService.SetupBudgetTrackingAsync(request);

        // Assert
        result.Should().NotBeNull();
        result.Success.Should().BeTrue();
        result.BudgetId.Should().NotBeNull();

        // Verify budget saved to database
        var savedBudget = await _context.BudgetTracking
            .FirstOrDefaultAsync(b => b.UserId == _testUserId);
        savedBudget.Should().NotBeNull();
        savedBudget!.MonthlyBudget.Should().Be(2000);
    }

    [Fact]
    public async Task GetGoalTrackingProgressAsync_ValidUserId_ShouldReturnProgress()
    {
        // Arrange - Create a financial goal
        var goal = new FinancialGoal
        {
            Id = Guid.NewGuid(),
            UserId = _testUserId,
            GoalName = "Save 10000 credits",
            TargetAmount = 10000,
            CurrentAmount = 3000,
            TargetDate = DateTime.UtcNow.AddMonths(6),
            Status = GoalStatus.InProgress,
            CreatedAt = DateTime.UtcNow
        };
        _context.FinancialGoals.Add(goal);
        await _context.SaveChangesAsync();

        // Act
        var progress = await _reportingService.GetGoalTrackingProgressAsync(_testUserId);

        // Assert
        progress.Should().NotBeNull();
        progress.Should().HaveCount(1);
        progress.First().GoalName.Should().Be("Save 10000 credits");
        progress.First().ProgressPercentage.Should().Be(30);  // 3000 / 10000 = 30%
    }

    [Fact]
    public async Task UpdateUserGoalsAsync_ValidParameters_ShouldReturnTrue()
    {
        // Arrange - Create a financial goal
        var goal = new FinancialGoal
        {
            Id = Guid.NewGuid(),
            UserId = _testUserId,
            GoalName = "Initial goal",
            TargetAmount = 5000,
            CurrentAmount = 1000,
            TargetDate = DateTime.UtcNow.AddMonths(3),
            Status = GoalStatus.InProgress,
            CreatedAt = DateTime.UtcNow
        };
        _context.FinancialGoals.Add(goal);
        await _context.SaveChangesAsync();

        // Act
        var result = await _reportingService.UpdateUserGoalsAsync(goal.Id, 2500);

        // Assert
        result.Should().BeTrue();

        // Verify goal updated in database
        var updatedGoal = await _context.FinancialGoals.FindAsync(goal.Id);
        updatedGoal!.CurrentAmount.Should().Be(2500);
    }

    [Fact]
    public async Task CheckBudgetGoalAlertsAsync_WithBudgetExceeded_ShouldReturnAlerts()
    {
        // Arrange - Create budget with low threshold
        var budget = new BudgetTracking
        {
            Id = Guid.NewGuid(),
            UserId = _testUserId,
            MonthlyBudget = 1000,
            CurrentSpending = 900,  // 90% of budget
            AlertThreshold = 80,
            Month = DateTime.UtcNow.Month,
            Year = DateTime.UtcNow.Year,
            CreatedAt = DateTime.UtcNow
        };
        _context.BudgetTracking.Add(budget);
        await _context.SaveChangesAsync();

        // Act
        var alerts = await _reportingService.CheckBudgetGoalAlertsAsync(_testUserId);

        // Assert
        alerts.Should().NotBeNull();
        alerts.Should().NotBeEmpty();
        alerts.Should().Contain(a => a.Type == "warning");
    }

    public void Dispose()
    {
        _context.Database.EnsureDeleted();
        _context.Dispose();
    }
}
